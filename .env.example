# Copy to .env.local and fill in values for local development.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Backend API origin. Leave empty for same-origin via Vite proxy (recommended for local dev).
# When FE and BE are deployed separately, set to the BE URL, e.g. https://api.playback.rachmat.pro
VITE_API_BASE_URL=

# Optional: override the Vite dev proxy target (default http://localhost:3000)
# VITE_API_PROXY_TARGET=http://localhost:3000

# Entra redirect must match the app registration and the FE origin when using the split deployment.
# For local same-origin proxy, keep http://localhost:5173/auth/callback
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
