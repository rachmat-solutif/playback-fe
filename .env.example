# Copy to .env.local and fill in values for local development.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# --- Dev proxy (Vite, local only) ---
# FE calls same-origin /api, /auth, /health (src/lib/api.js:11, vite.config.js:18).
# Vite dev server proxies them to the BE so auth/session works without CORS.
# VITE_API_PROXY_TARGET controls the proxy destination:
# - Default: http://localhost:3000 (BE `npm run dev` in playback-be)
# - Override only if BE runs elsewhere, e.g. http://localhost:3001 or https://playback-be-staging.vercel.app
# - Production ignores this (Vercel uses vercel.json rewrites)
# - Requires restart of `npm run dev` after change
# - We use same-origin proxy, so DO NOT set VITE_API_BASE_URL
# VITE_API_PROXY_TARGET=http://localhost:3000

# Theme: single primary per build (human-language presets). Build-time, baked via vite-plugin-build-theme.
# No runtime cost - changing requires rebuild (or hot-reload in dev via .env change).
# VITE_THEME selects a preset name; VITE_THEME_PRIMARY="#rrggbb" overrides the preset.
# Presets: crimson, ocean, forest, sunset, violet, slate, teal, midnight, coral, amber,
#          emerald, sapphire, ruby, lavender, charcoal, mint, blush, indigo, copper, arctic
# VITE_THEME=crimson
# VITE_THEME_PRIMARY=#0a7bc2

# Entra redirect must match the app registration and the FE origin when using the split deployment.
# For local same-origin proxy, keep http://localhost:5173/auth/callback
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
